# Copy to .env — never commit real secrets.
APP_NAME=FlowPilot
DEBUG=false

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql+psycopg2://flowpilot:flowpilot@db:5432/flowpilot

REDIS_URL=redis://redis:6379/0

# Min 32 chars — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-use-long-random-string-at-least-32-chars

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Used for optional HMAC-style verification patterns; also referenced in docs for webhook hardening
WEBHOOK_SECRET=change-me-webhook-signing-secret-min-16

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

MAX_WORKFLOW_STEPS=500
EXECUTION_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO

API_PREFIX=/api
